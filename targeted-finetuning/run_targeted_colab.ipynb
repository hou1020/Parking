    "if training_complete() and not FORCE_RETRAIN:\n",
    "    print('training already complete for this epoch budget')\n",
    "else:\n",
    "    train_targeted()\n",
    "\n",
    "LOG = pd.read_csv(LOG_CSV)\n",
    "display(LOG)"
